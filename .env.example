# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Public URL of THIS api (no trailing slash). Used by Better Auth for cookies
# and for links embedded in emails.
API_URL=http://localhost:8080

# Public URL of the admin panel frontend (no trailing slash).
APP_URL=http://localhost:5173

# Comma separated list of origins allowed to call the panel API with cookies.
# APP_URL is always allowed; add extra origins (preview deploys) here.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database (Railway Postgres)
# ---------------------------------------------------------------------------
# The role the server connects as. Tenant isolation is enforced by Postgres
# row level security, which superusers and BYPASSRLS roles skip, so in
# production this must be a plain role (scripts/create-app-role.sql) or the
# server refuses to start. Locally a superuser works, with a boot warning.
DATABASE_URL=postgresql://yak_app:password@localhost:5432/yak

# Owner connection for `npm run db:migrate`. Migrations alter tables and move
# data across tenants, which the restricted role cannot. Leave blank to reuse
# DATABASE_URL (local development).
MIGRATION_DATABASE_URL=

# Set to false only for local Postgres without TLS.
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Secrets - generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
# Signs sessions and tokens.
BETTER_AUTH_SECRET=

# Encrypts secrets at rest (Discord webhook URLs, outbound webhook secrets).
# Must be exactly 32 bytes, base64 encoded: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Product identity. One deployment serves every customer account; each
# account's own brand is set in its panel under Settings > Theme.
# ---------------------------------------------------------------------------
# Shown on the login screen and in account emails. Defaults to Yak.
APP_NAME=Yak
# Session cookie prefix. Defaults to the old TENANT_SLUG when that is still
# set (so upgrading does not sign anyone out), otherwise `yak`.
AUTH_COOKIE_PREFIX=

# ---------------------------------------------------------------------------
# Cloudflare Email Service (outbound transactional email)
# https://developers.cloudflare.com/email-service/
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Yak

# ---------------------------------------------------------------------------
# Cloudflare R2 (branding logo + user avatars via presigned URLs)
# https://developers.cloudflare.com/r2/
# ---------------------------------------------------------------------------
# Reuses CLOUDFLARE_ACCOUNT_ID above.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yak-media
# Optional: eu, fedramp, etc. Leave blank for the default jurisdiction.
R2_JURISDICTION=
# Seconds a signed read URL stays valid after /api/media redirects.
R2_URL_TTL=3600

# ---------------------------------------------------------------------------
# Ingest API rate limits - requests per minute, per API key
# ---------------------------------------------------------------------------
# Reports and users. Leave blank for the default of 600.
INGEST_RATE_LIMIT_PER_MINUTE=
# Events. Each request can carry 200 events. Leave blank for the default of 300.
EVENT_INGEST_RATE_LIMIT_PER_MINUTE=

# ---------------------------------------------------------------------------
# Bootstrap super admin - created on boot while no super admin exists, or by
# `npm run create:super-admin`. Super admins create customer accounts.
# Set SUPER_ADMIN_RESET_PASSWORD=true for one boot to reissue its password.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Stripe - keys are read and validated now; nothing calls Stripe yet.
# Use test mode keys (sk_test_, pk_test_) everywhere except production: a
# live secret key is refused unless NODE_ENV=production. Account tiers are set
# from the admin console until billing is connected.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard webhook endpoint, once one exists (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Rate limits are always on. Set to true only on a developer machine where hot
# reload loops trip them; ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false
